__pycache__/
*.pyc
*.egg-info/
.venv/
logs/
logs_queue/
outputs/
wandb/
experiments/
.omc/
docs/superpowers/

# generated PDFs in docs/reference/ are derivatives of the .md SSOT; regenerate via pandoc, never commit
docs/reference/*.pdf

# npz-replay test fixtures (large binary eval outputs; provenance in SOURCE.txt)
# encoder/  is excluded from this ignore rule so the mini checkpoint can be committed
tests/fixtures/*
!tests/fixtures/encoder/

# obs-oracle dumps: regenerable output of tools/obs_oracle/dump_obs_oracle.py
# (the script itself IS tracked; only its .npz product is not)
tools/obs_oracle/*.npz

# omx wiki runtime lock
.omx/registry/.wiki-lock

# omx scratch — intermediate analysis scaffolding, not tracked
.omx/scratch/

# deploy artifacts tree (weights/golden/runtime packs; on disk for docker cp / Mac pull, out of git)
# layout: deploy/<group>/<label>_<YYMMDD_HHMMSS>/ (mirrors logs tree, label-before-date)
# root-anchored: must NOT catch constrained_albc/deploy/ (code) or tests/deploy/
/deploy/
scratch/
.trash/

# session/tool state dirs — never commit
.claude/
.ruff_cache/
.superpowers/
.omx/state/

# --- Code-graph indexes (regenerated from source; .graphifyignore stays tracked) ---
.graphify/
graphify-out/
.code-review-graph/
.tokensave/
