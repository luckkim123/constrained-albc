# This directory is a `.hq` anchor root (`.hq/.anchor`).
# The rule lives beside the anchor rather than in some parent so that it
# travels with the anchor and no parent file needs editing when another
# anchor is seeded.

# migrated.jsonl is an append-only migration ledger. Every machine and linked
# worktree appends its own lines, so a 3-way merge conflicts on essentially
# every sync. union keeps both sides -- entries may interleave, which is
# harmless because the file is read per-entry.
.hq/config/migrated.jsonl merge=union

# The omx registry log is append-only for the same reason.
.hq/config/experiments/registry/log.md merge=union
